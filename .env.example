# ========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỊCH SÁCH (BOOK TRANSLATION)
# Sao chép tệp này thành .env và điền các khóa API của bạn:
#   cp .env.example .env
# ========================================================

# 1. Khóa API Dịch thuật (Bắt buộc ít nhất 1 nhà cung cấp)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Tùy chọn: Google Gemini hoặc Anthropic Claude
# GEMINI_API_KEY=your-gemini-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# 2. Cổng chạy Web Dashboard
PORT=3000

# 3. Thư mục làm việc (Mặc định tự động nhận diện thư mục gốc của dự án)
# WORKSPACE_ROOT=/path/to/dich-sach

# 4. Tùy chọn: Cloudflare R2 Storage (Dùng để đồng bộ sách lên cloud / website nếu cần)
# CLOUDFLARE_ACCOUNT_ID=your_account_id
# R2_ACCESS_KEY_ID=your_access_key_id
# R2_SECRET_ACCESS_KEY=your_secret_access_key
# R2_BUCKET=your_bucket_name
# R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
